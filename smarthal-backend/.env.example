RTSP_URL=rtsp://admin:<password>@<camera-ip>:554/h264Preview_01_main

# Optional. SQLite file for users etc. Relative to this folder.
# DB_PATH=data/dev.db

# Optional. Comma-separated frontend origins allowed to call the API ('*' is refused).
# CORS_ORIGINS=http://localhost:5173

# Optional. Face library for Register Resident: insightface (default) or opencv.
# FACE_BACKEND=insightface

# Optional. How similar a camera face must be to a resident to be named on Live Feed
# (default 0.4 for insightface). Higher = fewer false matches, more "Unknown".
# RECOGNITION_THRESHOLD=0.4

# Optional. Photo/screen check before a resident is named on Live Feed (on by default).
# LIVENESS_CHECK=on
# LIVENESS_THRESHOLD=0.5
# LIVENESS_MIN_FACE_PX=80
